{
  "manifest_version": 3,
  "name": "Syllavox",
  "version": "1.0.0",
  "description": "Read selected browser text using the local offline Syllavox desktop application.",

  "browser_specific_settings": {
    "gecko": {
      "id": "@syllavox",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "contextMenus",
    "notifications"
  ],

  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],

  "background": {
  "scripts": ["background.js"]
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
