{
  "manifest_version": 3,
  "name": "Syllavox",
  "version": "0.4.0",
  "description": "Read selected browser text using the local offline Syllavox desktop application.",

  "browser_specific_settings": {
    "gecko": {
      "id": "@syllavox",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications"
  ],

  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],

  "background": {
  "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
