{
  "manifest_version": 3,
  "name": "Syllavox",
  "version": "0.5.0",
  "description": "Read selected browser text using the local offline Syllavox desktop application.",

  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications"
  ],

  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],

  "background": {
  "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "114"
}
